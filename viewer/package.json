{
  "name": "asyncapi-viewer",
  "version": "2.1.1",
  "description": "Renders AsyncAPI 2 and 3 documents as a web component: <asyncapi-viewer src=\"...\">",
  "keywords": [
    "asyncapi",
    "web-component",
    "documentation",
    "event-driven",
    "api",
    "lit"
  ],
  "license": "MIT",
  "homepage": "https://weesho-lapara.github.io/asyncapi-viewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weesho-Lapara/asyncapi-viewer.git",
    "directory": "viewer"
  },
  "bugs": "https://github.com/Weesho-Lapara/asyncapi-viewer/issues",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "!dist/*.map",
    "theme",
    "types",
    "README.md"
  ],
  "main": "./dist/asyncapi-viewer.js",
  "module": "./dist/asyncapi-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/asyncapi-viewer.js"
    },
    "./iife": "./dist/asyncapi-viewer.iife.js",
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./types/react.js"
    },
    "./theme/asyncapi-theme.css": "./theme/asyncapi-theme.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "tsx scripts/coverage.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "sync-examples": "tsx scripts/sync-spec-examples.ts"
  },
  "dependencies": {
    "lit": "^3.3.0",
    "markdown-it": "^15.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
