{
  // Type-checks the app against the types the npm package ships (build.mjs runs tsc first), as
  // a TypeScript React project would.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
