{
  // Declarations for the npm package: dist/types/ (package.json "types"), written after the Vite
  // build, which empties dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"]
}
